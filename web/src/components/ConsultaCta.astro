---
// Figma component "CTA ¿Tienes una consulta?" (Sobre mí, Servicios, Talleres)
import mailIcon from '../assets/svg/mail.svg';
import leafGold from '../assets/svg/hoja-dorada-2.svg';
import Img from './Img.astro';
import type { Site } from '../lib/content';
import { waLink } from '../lib/text';

interface Props { site: Site }
const { site } = Astro.props;
---
<section class="cta wrap--panel">
  <slot />
  <div class="cta__card panel" data-reveal>
    <img class="cta__leaf" src={leafGold.src} alt="" aria-hidden="true">
    <Img class="cta__img" pic={site.consulta.image} width={460} />
    <div class="cta__text">
      <h2 class="display">{site.consulta.title}</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}><span class="chip"><img src={mailIcon.src} alt="" /></span>{site.email}</a></li>
      </ul>
      <div class="cta__btns">
        <a class="btn btn--gold" href={site.doctoralia} target="_blank" rel="noopener">{site.bookingLabel}</a>
        <a class="btn btn--white" href={waLink(site.whatsapp)} target="_blank" rel="noopener">{site.whatsappLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; z-index: 1; max-width: 1440px; margin-inline: auto; padding-top: 40px; padding-bottom: 110px; }
  .cta__card { display: flex; align-items: center; gap: 70px; padding: 24px 90px 24px 24px; background: var(--purple); color: var(--white); }
  .cta__leaf { position: absolute; width: 190px; right: 10px; top: -60px; transform: rotate(12deg); pointer-events: none; }
  .cta__card :global(.cta__img) { flex: none; width: 460px; max-width: 40%; height: 380px; object-fit: cover; border-radius: 30px 190px 30px 30px; }
  .cta__text { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .cta__text h2 { font-size: clamp(34px, 3.2vw, 46px); line-height: 1.12; }
  .cta__text ul { display: flex; flex-direction: column; gap: 22px; }
  .cta__text li a { display: flex; align-items: center; gap: 14px; font-weight: 500; font-size: 17px; word-break: break-word; }
  .cta__text li a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cta__text .chip { background: var(--white); }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  /* Figma "CTA consulta mobile" */
  @media (max-width: 900px) {
    .cta { padding-top: 24px; padding-bottom: 64px; }
    .cta__card { flex-direction: column; align-items: stretch; gap: 24px; padding: 16px 16px 28px; }
    .cta__card :global(.cta__img) { width: 100%; max-width: none; height: 240px; border-radius: 22px 120px 22px 22px; object-position: center 25%; }
    .cta__leaf { width: 120px; top: -30px; right: -10px; }
    .cta__text { padding-inline: 8px; gap: 18px; }
    .cta__text h2 { font-size: 32px; }
    .cta__text li a { font-size: 15px; }
    .cta__btns { width: 100%; }
    .cta__btns .btn { flex: 1; padding-inline: 16px; }
  }
</style>
