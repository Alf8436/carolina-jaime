---
// Figma "Blog – Propuesta C" › Artículos: the latest post featured, the rest in a
// grid, categories and a booking card on the side.
import leafGold from '../assets/svg/hoja-dorada.svg';
import leafRose from '../assets/svg/hoja-rosa-cat.svg';
import Img from './Img.astro';
import PostCard from './PostCard.astro';
import type { Category, PostSummary, Site } from '../lib/content';
import { formatDate, waLink } from '../lib/text';

interface Props { site: Site; posts: PostSummary[]; categories: Category[]; current?: string }
const { site, posts, categories, current } = Astro.props;
const [featured, ...rest] = posts;
---
<section class="list wrap">
  <slot />
  <div class="list__main">
    {!featured && <p class="list__empty muted">Pronto encontrarás aquí nuevos artículos.</p>}
    {featured && (
      <article class="feat" data-reveal>
        <a class="feat__img" href={`/blog/${featured.slug}`} tabindex="-1" aria-hidden="true"><Img pic={featured.image} width={440} /></a>
        <div class="feat__text">
          <time datetime={featured.date}>{formatDate(featured.date)}</time>
          <h2 class="display"><a href={`/blog/${featured.slug}`}>{featured.title}</a></h2>
          <p class="muted">{featured.excerpt}</p>
          <a class="btn btn--purple" href={`/blog/${featured.slug}`}>Leer artículo</a>
        </div>
      </article>
    )}
    {rest.length > 0 && (
      <>
        <hr class="list__sep" />
        <div class="list__grid">
          {rest.map((post) => <div data-reveal><PostCard post={post} headingLevel="h2" /></div>)}
        </div>
      </>
    )}
  </div>

  <aside class="side">
    {categories.length > 0 && (
      <nav class="side__cats" aria-label="Categorías" data-reveal>
        <img class="side__leaf" src={leafRose.src} alt="" aria-hidden="true">
        <h2 class="display">Categorías</h2>
        <ul>
          {current && <li><a href="/blog"><span><img src={leafGold.src} width="18" height="14" alt="" />Todas</span><span aria-hidden="true">→</span></a></li>}
          {categories.map((c) => (
            <li>
              <a href={`/blog/categoria/${c.slug}`} aria-current={c.slug === current ? 'page' : undefined}>
                <span><img src={leafGold.src} width="18" height="14" alt="" />{c.title}</span><span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="side__book" data-reveal>
      <p class="display">{site.consulta.title}</p>
      <a class="btn btn--gold" href={site.doctoralia} target="_blank" rel="noopener">{site.bookingLabel}</a>
      <a class="btn btn--white" href={waLink(site.whatsapp)} target="_blank" rel="noopener">{site.whatsappLabel}</a>
    </div>
  </aside>
</section>

<style>
  .list { position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 56px; padding-top: 90px; padding-bottom: 90px; }
  .list__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 48px; }
  .list__empty { font-size: 18px; }
  .feat { display: flex; align-items: center; gap: 40px; }
  .feat__img { flex: none; width: 440px; max-width: 48%; height: 340px; overflow: hidden; border-radius: 28px; }
  .feat__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .feat:hover .feat__img :global(img) { transform: scale(1.04); }
  .feat__text { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .feat__text time { font-weight: 600; font-size: 14px; color: var(--rose-dark); }
  .feat__text h2 { font-size: clamp(30px, 2.8vw, 40px); line-height: 1.15; }
  .feat__text h2 a:hover { color: var(--purple); }
  .feat__text p { font-size: 16px; line-height: 1.6; }
  .feat__text .btn { margin-top: 6px; }
  .list__sep { width: 100%; height: 1px; margin: 0; border: 0; background: var(--sage-line); }
  .list__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 28px; }

  .side { flex: none; width: 320px; display: flex; flex-direction: column; gap: 24px; }
  .side__cats { position: relative; overflow: hidden; padding: 32px 32px 20px; border-radius: 28px; background: var(--sage-soft); }
  .side__leaf { position: absolute; width: 110px; left: 240px; top: -80px; transform: rotate(-30deg); pointer-events: none; }
  .side__cats h2 { position: relative; font-size: 28px; margin-bottom: 14px; }
  .side__cats li { border-top: 1px solid var(--sage-line); }
  .side__cats a { display: flex; align-items: center; justify-content: space-between; padding-block: 14px; font-weight: 500; font-size: 16px; }
  .side__cats a span:first-child { display: flex; align-items: center; gap: 10px; }
  .side__cats a span:last-child { color: var(--purple); transition: transform .25s var(--ease); }
  .side__cats a:hover span:last-child { transform: translateX(4px); }
  .side__cats a[aria-current] { color: var(--purple); font-weight: 700; }
  .side__book { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 32px; border-radius: 28px; background: var(--purple); color: var(--white); }
  .side__book .display { font-size: 28px; line-height: 1.15; }

  @media (max-width: 1100px) {
    .list { flex-direction: column; align-items: stretch; }
    .side { width: auto; flex-direction: row; }
    .side > * { flex: 1; }
  }
  /* Figma "Blog – Mobile 375" */
  @media (max-width: 760px) {
    .list { gap: 40px; padding-top: 48px; padding-bottom: 56px; }
    .list__main { gap: 32px; }
    .feat { flex-direction: column; align-items: stretch; gap: 18px; }
    .feat__img { width: 100%; max-width: none; height: 220px; border-radius: 22px; }
    .feat__text .btn { width: 100%; }
    .list__grid { grid-template-columns: 1fr; }
    .side { flex-direction: column; }
  }
</style>
