---
import ring from '../../assets/svg/anillo.svg';
import leafRose from '../../assets/svg/hoja-rosa.svg';
import leafGold from '../../assets/svg/hoja-dorada.svg';
import Img from '../Img.astro';
import Eyebrow from '../Eyebrow.astro';
import type { Home } from '../../lib/content';

interface Props { about: Home['about'] }
const { about } = Astro.props;
---
<section class="about wrap">
  <slot />
  <div class="about__visual" data-reveal>
    <img class="about__leaf about__leaf--rose" src={leafRose.src} alt="" aria-hidden="true">
    <img class="about__ring" src={ring.src} alt="" aria-hidden="true">
    <Img class="about__photo" pic={about.image} width={420} />
    <img class="about__leaf about__leaf--gold" src={leafGold.src} alt="" aria-hidden="true">
  </div>
  <div class="about__text">
    <Eyebrow text={about.eyebrow} />
    <blockquote class="display about__quote" data-reveal>{about.quote}</blockquote>
    <div class="about__sign" data-reveal>
      <span class="about__line" aria-hidden="true"></span>
      <div>
        <p class="about__name">{about.name}</p>
        <p class="muted">{about.role}</p>
      </div>
    </div>
    <a class="btn btn--outline" href="/sobre-mi" data-reveal>{about.cta}</a>
  </div>
</section>

<style>
  .about { position: relative; z-index: 1; display: flex; align-items: center; gap: 100px; padding-top: 110px; padding-bottom: 120px; padding-inline: clamp(20px, 11vw, 160px); }
  .about__visual { position: relative; flex: none; width: 460px; height: 480px; }
  .about__ring { position: absolute; left: 20px; top: 20px; width: 440px; height: 440px; }
  /* Portrait photo: framed from the top so the head isn't cut (a Sanity hotspot overrides it) */
  .about__visual :global(.about__photo) { position: absolute; left: 0; top: 0; width: 420px; height: 420px; border-radius: 50%; object-fit: cover; object-position: center top; }
  .about__leaf { position: absolute; pointer-events: none; }
  .about__leaf--rose { width: 150px; left: -110px; top: 270px; transform: rotate(75deg); opacity: .55; }
  .about__leaf--gold { width: 220px; left: 225px; top: 360px; transform: rotate(-8deg); }

  .about__text { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .about__quote { font-size: clamp(28px, 2.8vw, 40px); line-height: 1.22; }
  .about__sign { display: flex; align-items: center; gap: 16px; }
  .about__line { flex: none; width: 40px; height: 2px; background: var(--gold); }
  .about__name { font-weight: 700; font-size: 16px; }
  .about__sign .muted { font-size: 15px; }

  @media (max-width: 1100px) {
    .about { gap: 56px; }
    .about__visual { width: 360px; height: 380px; }
    .about__ring { width: 345px; height: 345px; left: 15px; top: 15px; }
    .about__visual :global(.about__photo) { width: 330px; height: 330px; }
    .about__leaf--gold { width: 170px; left: 180px; top: 285px; }
  }
  @media (max-width: 900px) {
    .about { padding-inline: var(--gutter-wide); flex-direction: column; align-items: stretch; gap: 32px; padding-top: 80px; padding-bottom: 72px; }
    .about__visual { width: 300px; height: 320px; margin-inline: auto; }
    .about__ring { width: 290px; height: 290px; left: 10px; top: 10px; }
    .about__visual :global(.about__photo) { width: 280px; height: 280px; }
    .about__leaf--gold { width: 150px; left: 150px; top: 245px; }
    .about__leaf--rose { width: 110px; left: -70px; top: 200px; }
    .about__quote { font-size: 26px; }
    .about__sign { align-items: flex-start; }
    .about__line { margin-top: 18px; }
  }
</style>
