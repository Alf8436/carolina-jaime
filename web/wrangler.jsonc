// Astro rendered on Cloudflare Workers (`npm run deploy`): the Worker builds each
// page with the current Sanity content. The adapter adds the entry point and the
// static assets binding at build time (dist/server/wrangler.json).
{
  "name": "carolina-jaime",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker answers on the domain; www redirects to it (src/middleware.ts)
  "workers_dev": true,
  "routes": [
    { "pattern": "carolinajaime.com", "custom_domain": true },
    { "pattern": "www.carolinajaime.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
