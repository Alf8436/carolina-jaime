---
// Newsletter card (Home, Blog, articles). Subscribes through /api/newsletter → MailerLite.
import leafGold from '../assets/svg/hoja-dorada-2.svg';
import Img from './Img.astro';
import type { Site } from '../lib/content';

interface Props { newsletter: Site['newsletter'] }
const { newsletter } = Astro.props;
---
<section class="news wrap--panel">
  <slot />
  <div class="news__card panel" data-reveal>
    <img class="news__leaf" src={leafGold.src} alt="" aria-hidden="true">
    <Img class="news__img" pic={newsletter.image} width={500} />
    <div class="news__text">
      <h2 class="display">{newsletter.title}</h2>
      <p>{newsletter.text}</p>
      <form class="news__form" action="/api/newsletter" method="post" data-form="newsletter">
        <label class="sr-only" for="news-email">Tu email</label>
        <input id="news-email" name="email" type="email" required autocomplete="email" placeholder="Ingresa tu email">
        <!-- Bots fill every field; people never see this one -->
        <input class="sr-only" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn btn--gold" type="submit">Suscribir</button>
      </form>
      <p class="news__status" role="status" data-status></p>
    </div>
  </div>
</section>

<style>
  .news { position: relative; z-index: 1; max-width: 1440px; margin-inline: auto; padding-top: 20px; padding-bottom: 40px; }
  .news__card { display: flex; align-items: center; gap: 70px; padding: 24px 90px 24px 24px; background: var(--purple); color: var(--white); }
  .news__leaf { position: absolute; width: 190px; right: -10px; top: -60px; transform: rotate(12deg); pointer-events: none; }
  .news__card :global(.news__img) { flex: none; width: 500px; max-width: 42%; height: 380px; border-radius: 30px; object-fit: cover; }
  .news__text { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .news__text h2 { font-size: clamp(32px, 3vw, 44px); line-height: 1.15; }
  .news__text > p { font-size: 17px; line-height: 1.55; }
  .news__form { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 24px; border-radius: 999px; background: var(--white); }
  .news__form input[type='email'] { flex: 1; min-width: 0; border: 0; background: none; color: var(--text); font-size: 15px; outline: none; }
  .news__form input::placeholder { color: var(--muted); }
  .news__form:focus-within { box-shadow: 0 0 0 3px rgb(242 199 145 / .6); }
  .news__status { min-height: 1.5em; font-size: 15px; font-weight: 500; }
  .news__status:empty { display: none; }

  @media (max-width: 900px) {
    .news__card { flex-direction: column; align-items: stretch; gap: 24px; padding: 16px 16px 28px; }
    .news__card :global(.news__img) { width: 100%; max-width: none; height: 170px; border-radius: 22px; }
    .news__leaf { width: 120px; top: -30px; right: -10px; }
    .news__text { padding-inline: 8px; gap: 16px; }
    .news__text h2 { font-size: 30px; }
    .news__text > p { font-size: 15px; }
    .news__form { flex-direction: column; align-items: stretch; gap: 14px; padding: 0; background: none; }
    .news__form input[type='email'] { padding: 14px 20px; border-radius: 999px; background: var(--white); }
    .news__form:focus-within { box-shadow: none; }
    .news__form input[type='email']:focus { box-shadow: 0 0 0 3px rgb(242 199 145 / .6); }
  }
</style>
